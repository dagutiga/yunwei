# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=vm_management

# SSH密钥配置（使用 `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"` 生成）
SSH_SECRET_KEY=YOUR_FERNET_KEY

# SSH配置
SSH_TIMEOUT=10

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/vm_management.log

# API配置
API_HOST=0.0.0.0
API_PORT=8000
